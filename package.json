{
  "name": "ai-terminal-hub",
  "version": "1.10.0",
  "description": "AI Terminal Hub，本地任务文件夹驱动的多 AI CLI 统一控制台。",
  "author": "yamijin",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run compile && concurrently -k \"vite --config electron/vite.config.electron.ts\" \"wait-on http://localhost:1421 && VITE_DEV_SERVER_URL=http://localhost:1421 electron --no-sandbox dist-electron/main.js\"",
    "compile": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "build:frontend": "NODE_OPTIONS='--max-old-space-size=4096' vite build --config electron/vite.config.electron.ts",
    "build": "npm run build:frontend && npm run compile && electron-builder",
    "build:mac-dir": "npm run build:frontend && npm run compile && electron-builder --mac dir --publish never",
    "rebuild-native": "electron-rebuild -f -w node-pty",
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@xterm/addon-fit": "^0.12.0-beta.195",
    "@xterm/addon-web-links": "^0.13.0-beta.195",
    "@xterm/addon-webgl": "^0.20.0-beta.194",
    "@xterm/xterm": "^6.1.0-beta.195",
    "node-pty": "^1.1.0",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^25.3.0",
    "concurrently": "^9.2.1",
    "electron": "^40.8.5",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.ai-terminal-hub.app",
    "productName": "AI Terminal Hub",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "electron/preload.cjs"
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/node-pty/prebuilds/**"
    }
  }
}
